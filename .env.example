# OrthoInsight — environment variables
# ====================================
# Copy this file to .env.local and adjust as needed.

# Uncomment to point the frontend at the real Python backend.
# Leave empty to use the built-in simulated responses (no backend required).
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Optional — enables GPT-4o-mini for richer RAG answers.
# Without it, a template-based synthesis from real PubMed abstracts is used.
# OPENAI_API_KEY=sk-...
