# OrthoInsight — environment variables
# ====================================
# Copy this file to .env.local and adjust as needed.

# Required. Points the frontend at backend/server.py. There is no simulated
# fallback — if this is unset or the backend isn't reachable, /api/query and
# /api/analyze return a 503 explaining why, instead of a fabricated answer.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Optional — enables GPT-4o-mini for richer RAG answers.
# Without it, a template-based synthesis from real PubMed abstracts is used.
# OPENAI_API_KEY=sk-...
